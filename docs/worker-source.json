"importScripts('https://cdn.jsdelivr.net/pyodide/v0.28.3/full/pyodide.js');\nonmessage=async ({data})=>{let output='';const started=Date.now();try{const py=await loadPyodide({indexURL:'https://cdn.jsdelivr.net/pyodide/v0.28.3/full/',stdout:s=>{if(output.length<32000)output+=s+'\\n';},stderr:s=>{if(output.length<32000)output+=s+'\\n';}});py.FS.mkdir('/work');py.FS.chdir('/work');py.FS.writeFile('solution.py',data.code);py.FS.writeFile('test_solution.py',data.tests);py.FS.writeFile('runner.py',\"\\\"\\\"\\\"Container-only regression runner with structured results and line coverage.\\\"\\\"\\\"\\nimport ast\\nimport io\\nimport json\\nimport os\\nimport sys\\nimport trace\\nimport unittest\\nsys.path.insert(0, os.getcwd())\\n\\noutput = io.StringIO()\\nrunner = unittest.TextTestRunner(stream=output, verbosity=2)\\ntracer = trace.Trace(count=True, trace=False)\\nresult = None\\nerror = None\\ntry:\\n    def execute():\\n        suite = unittest.defaultTestLoader.discover('.', pattern='test_solution.py')\\n        return runner.run(suite)\\n    result = tracer.runfunc(execute)\\nexcept BaseException as exc:\\n    error = str(exc)\\n\\nsource = os.path.abspath('solution.py')\\n# Statement-line coverage, explicitly excluding blank lines and comments.\\ntry:\\n    tree = ast.parse(open(source).read())\\n    executable = {node.lineno for node in ast.walk(tree) if isinstance(node, ast.stmt)}\\nexcept (OSError, SyntaxError):\\n    executable = set()\\nhits = {line for (filename, line), count in tracer.results().counts.items() if os.path.abspath(filename) == source and count > 0}\\ncovered = executable & hits\\nreport = {\\n    'tests_run': result.testsRun if result else 0,\\n    'failures': len(result.failures) if result else 0,\\n    'errors': len(result.errors) if result else 1,\\n    'skipped': len(result.skipped) if result else 0,\\n    'coverage_percent': round(100 * len(covered) / len(executable), 1) if executable else None,\\n    'covered_lines': sorted(covered),\\n    'missing_lines': sorted(executable - hits),\\n    'coverage_kind': 'Python statement-line coverage',\\n}\\nprint(output.getvalue()[:24000])\\nif error:\\n    print(error)\\nprint('FIXLAB_REPORT=' + json.dumps(report), flush=True)\\nsys.exit(0 if result and result.testsRun > 0 and result.testsRun > len(result.skipped) and result.wasSuccessful() else 1)\\n\");let exitCode=0;try{exitCode=await py.runPythonAsync(\"import sys\\nsys.path.insert(0, '/work')\\n_exit_code=0\\ntry:\\n    exec(compile(open('runner.py').read(), 'runner.py', 'exec'))\\nexcept SystemExit as e:\\n    _exit_code=e.code or 0\\n_exit_code\");}catch(e){exitCode=1;output+=String(e).slice(0,2000);}const line=output.split('\\n').find(x=>x.startsWith('FIXLAB_REPORT='));const report=line?JSON.parse(line.slice(14)):null;postMessage({passed:exitCode===0&&!!report&&report.tests_run>report.skipped,exit_code:exitCode,report,output:output.slice(0,32000),duration_seconds:(Date.now()-started)/1000,timed_out:false});}catch(e){postMessage({error:String(e)});}};"